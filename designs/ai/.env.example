# Formula Recognition Configuration
# Copy this file to .env and fill in your API credentials

# Mathpix OCR API
# Sign up at https://mathpix.com/ to get credentials
VITE_MATHPIX_APP_ID=your_app_id_here
VITE_MATHPIX_APP_KEY=your_app_key_here

# Recognition Parameters
VITE_CONFIDENCE_THRESHOLD=0.65
VITE_MAX_IMAGE_SIZE=4096

# TensorFlow.js Model Path (when available)
VITE_TFJS_MODEL_PATH=/models/im2latex/model.json

# API Rate Limiting
VITE_MAX_REQUESTS_PER_MINUTE=30
VITE_REQUEST_TIMEOUT=10000

# Feature Flags
VITE_ENABLE_PDF_EXTRACTION=true
VITE_ENABLE_BATCH_PROCESSING=true
VITE_ENABLE_ANALYTICS=true
