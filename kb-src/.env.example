# Database Configuration Template
# Copy this file to .env and configure your settings

# Database Engine (sqlite, postgresql, mongodb)
DB_ENGINE=sqlite

# SQLite Configuration (local development)
SQLITE_PATH=./kb-src/data/formula-nebula.db

# PostgreSQL Configuration (production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=formula_nebula
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_MAX_CONNECTIONS=20

# MongoDB Configuration (optional document storage)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=formula_nebula
# Or use connection string:
# MONGO_URI=mongodb://localhost:27017/formula_nebula

# Redis Configuration (caching layer)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache Settings
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300000  # 5 minutes in milliseconds
CACHE_MAX_MEMORY=100      # MB for memory cache

# Query Settings
QUERY_TIMEOUT=30000       # 30 seconds
ENABLE_QUERY_LOG=false

# Migration Settings
AUTO_MIGRATE=false        # Automatically run migrations on startup
