{
  "dashboard": {
    "id": null,
    "uid": "formula-nebula-overview",
    "title": "Formula Nebula - System Overview",
    "tags": ["formula-nebula", "monitoring", "overview"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\"}",
          "iconColor": "rgba(255, 96, 96, 1)",
          "name": "Active Alerts",
          "step": "60s",
          "tagKeys": "alertname,severity",
          "textFormat": "{{ alertname }}",
          "titleFormat": "Alert"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Application Health",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Application Status",
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "up{job=\"formula-nebula-app\"}",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "text": {},
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            },
            "mappings": [
              { "type": "value", "value": "0", "text": "DOWN" },
              { "type": "value", "value": "1", "text": "UP" }
            ]
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Request Rate",
        "datasource": "Prometheus",
        "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "text": {},
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 10, "color": "yellow" },
                { "value": 50, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Error Rate",
        "datasource": "Prometheus",
        "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(errors_total[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "errors/s",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 5, "color": "yellow" },
                { "value": 10, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Active WebSocket Connections",
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "ws_connections_active",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 500, "color": "yellow" },
                { "value": 1000, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "Graph Nodes",
        "datasource": "Prometheus",
        "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "graph_nodes_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" }
          }
        }
      },
      {
        "id": 7,
        "type": "stat",
        "title": "Rendering FPS",
        "datasource": "Prometheus",
        "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "render_fps",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 30, "color": "yellow" },
                { "value": 50, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "type": "row",
        "title": "Performance Metrics",
        "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 11,
        "type": "graph",
        "title": "HTTP Request Duration (P50, P95, P99)",
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          }
        ],
        "lines": true,
        "linewidth": 2,
        "fill": 0,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true,
          "max": true
        }
      },
      {
        "id": 12,
        "type": "graph",
        "title": "Frame Rendering Time",
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(render_frame_time_ms_bucket[5m]))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(render_frame_time_ms_bucket[5m]))",
            "legendFormat": "P95",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "ms",
            "label": "Time"
          }
        ],
        "seriesOverrides": [
          {
            "alias": "/Target.*/",
            "dashes": true,
            "color": "#FF0000"
          }
        ],
        "lines": true,
        "fill": 1
      },
      {
        "id": 20,
        "type": "row",
        "title": "Resource Utilization",
        "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 21,
        "type": "graph",
        "title": "Memory Usage",
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "memory_used_bytes{type=\"heap_used\"}",
            "legendFormat": "Heap Used",
            "refId": "A"
          },
          {
            "expr": "memory_used_bytes{type=\"heap_total\"}",
            "legendFormat": "Heap Total",
            "refId": "B"
          },
          {
            "expr": "memory_used_bytes{type=\"heap_limit\"}",
            "legendFormat": "Heap Limit",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "bytes",
            "label": "Memory"
          }
        ],
        "lines": true,
        "linewidth": 2,
        "fill": 1,
        "stack": false
      },
      {
        "id": 22,
        "type": "graph",
        "title": "Memory Usage %",
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "100 * (memory_used_bytes{type=\"heap_used\"} / memory_used_bytes{type=\"heap_limit\"})",
            "legendFormat": "Heap Usage %",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Usage",
            "min": 0,
            "max": 100
          }
        ],
        "lines": true,
        "linewidth": 2,
        "fill": 2,
        "thresholds": [
          {
            "value": 85,
            "colorMode": "critical",
            "op": "gt",
            "fill": true,
            "line": true
          }
        ]
      },
      {
        "id": 30,
        "type": "row",
        "title": "Error Tracking",
        "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 31,
        "type": "graph",
        "title": "Error Rate by Type",
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (type) (rate(errors_total[5m]))",
            "legendFormat": "{{ type }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "errors/s",
            "label": "Errors"
          }
        ],
        "lines": true,
        "stack": true,
        "fill": 5
      },
      {
        "id": 32,
        "type": "graph",
        "title": "HTTP Status Codes",
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (status) (rate(http_requests_total[5m]))",
            "legendFormat": "{{ status }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests"
          }
        ],
        "lines": true,
        "stack": true
      },
      {
        "id": 40,
        "type": "row",
        "title": "Business Metrics",
        "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 41,
        "type": "graph",
        "title": "Search Queries by Type",
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 33, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (type) (rate(search_queries_total[5m]))",
            "legendFormat": "{{ type }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "queries/s",
            "label": "Queries"
          }
        ],
        "lines": true,
        "fill": 1
      },
      {
        "id": 42,
        "type": "graph",
        "title": "WebSocket Messages",
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 33, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (direction) (rate(ws_messages_total[5m]))",
            "legendFormat": "{{ direction }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "msg/s",
            "label": "Messages"
          }
        ],
        "lines": true,
        "fill": 2
      },
      {
        "id": 50,
        "type": "row",
        "title": "Learning Paths",
        "gridPos": { "x": 0, "y": 41, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 51,
        "type": "graph",
        "title": "Active Learning Paths",
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 42, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "learning_paths_active",
            "legendFormat": "Active Paths",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Paths"
          }
        ]
      },
      {
        "id": 52,
        "type": "heatmap",
        "title": "Learning Path Progress Distribution",
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 42, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(learning_path_progress_bucket[5m])",
            "format": "heatmap",
            "refId": "A"
          }
        ],
        "yAxis": {
          "format": "percentunit",
          "decimals": 0
        },
        "cards": {
          "cardPadding": 2
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5
        }
      }
    ]
  },
  "overwrite": true,
  "inputs": [],
  "folderId": 0,
  "folderUid": ""
}
