{
  "name": "formula-nebula",
  "private": false,
  "version": "0.1.1",
  "type": "module",
  "description": "🌌 代数几何知识图谱的三维星云可视化 - 405条定理 + 59条猜想，探索数学的结构与美",
  "keywords": [
    "mathematics",
    "algebraic-geometry",
    "knowledge-graph",
    "3d-visualization",
    "webgl",
    "three.js",
    "education",
    "data-visualization",
    "interactive"
  ],
  "author": {
    "name": "Formula Nebula Team",
    "email": "formula-nebula@example.com",
    "url": "https://github.com/wenze-wu-math/Formula-Nebula"
  },
  "contributors": [
    {
      "name": "wenze-wu-math",
      "url": "https://github.com/wenze-wu-math"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wenze-wu-math/Formula-Nebula.git"
  },
  "bugs": {
    "url": "https://github.com/wenze-wu-math/Formula-Nebula/issues"
  },
  "homepage": "https://formula-nebula.vercel.app",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "quickstart": "node scripts/quickstart.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build && node scripts/analyze-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,css,html}\"",
    "quality": "node scripts/quality-check.mjs",
    "test": "node tests/canonicalization/run-tests.js && node tests/routing/run-tests.js && node tests/export/latex-escape.test.mjs && node tests/api-keys/permission-match.test.mjs",
    "test:routing": "node tests/routing/run-tests.js",
    "test:dupes": "node scripts/_check-dupe-keys.mjs && node scripts/_check-dupe-keys-control.mjs",
    "test:proofs": "node scripts/_verify-explanation-rescue.mjs",
    "test:pure": "node scripts/verify-url-state.mjs && node scripts/verify-graph-query.mjs && node scripts/verify-export.mjs && node scripts/verify-link-types.mjs && node scripts/verify-proofs.mjs && node scripts/_check-proof-file.mjs",
    "test:radius-shift": "node scripts/check-radius-shift.mjs",
    "ci": "npm run check-data && npm run audit && npm run test:dupes && npm run test:proofs && npm run test:pure && npm run test:graph && npm run test:layout && npm test && npm run build && npm run verify:assets && npm run verify:readme",
    "verify": "node scripts/run-all.mjs",
    "verify:proofs": "node scripts/verify-proofs.mjs",
    "verify:katex": "node verify-katex-optimization.mjs",
    "check-data": "node scripts/check-data.mjs",
    "perf": "node scripts/probe-perf.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "start": "vite --config vite.designs.config.mjs",
    "start:designs": "vite --config vite.designs.config.mjs",
    "collab:server": "node src/collaboration/server/index.js",
    "collab:demo": "npm run dev & npm run collab:server",
    "billing:server": "node src/billing/server.js",
    "billing:test": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/payments/stripe.test.js",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "restore": "node scripts/restore.mjs",
    "restore:latest": "node scripts/restore.mjs --latest",
    "dr:help": "node -e \"console.log('See DR_PLAYBOOK.md for disaster recovery procedures')\"",
    "load-test": "k6 run scripts/load-test.js",
    "load-test:smoke": "k6 run -e STAGE=smoke scripts/load-test.js",
    "load-test:stress": "k6 run -e STAGE=stress scripts/load-test.js",
    "load-test:simulate": "node scripts/simulate-load-test.mjs",
    "capacity-plan": "node scripts/capacity-plan.mjs",
    "capacity-report": "npm run load-test:simulate && npm run capacity-plan",
    "verify:assets": "node scripts/verify-assets.mjs",
    "health": "node scripts/health.mjs",
    "loop": "npm run score && npm run ci",
    "verify:readme": "node scripts/verify-readme-claims.mjs",
    "verify:designs": "node scripts/verify-designs.mjs",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "dev:designs": "vite --config vite.designs.config.mjs",
    "verify:designs:depth": "node scripts/verify-designs-depth.mjs",
    "verify:manuscript": "node scripts/verify-manuscript-deeplink.mjs",
    "verify:live": "node scripts/verify-live-site.mjs",
    "audit": "npm audit --audit-level=moderate",
    "score": "node scripts/score.mjs",
    "verify:final": "node scripts/verify-final.mjs",
    "test:graph": "node tests/graph/unit.test.mjs",
    "test:layout": "node tests/layout/unit.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "i18next": "^23.7.6",
    "i18next-browser-languagedetector": "^7.2.1",
    "i18next-http-backend": "^4.0.9",
    "katex": "^0.19.1",
    "mathjax-full": "^3.2.2",
    "stripe": "^17.5.0",
    "three": "^0.180.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
