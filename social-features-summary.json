  "data_schema": {
    "storage_type": "localStorage + in-memory cache",
    "entities": [
      {
        "name": "UserProfile",
        "key_pattern": "social:profiles:<userId>",
        "fields": ["userId", "username", "avatar", "bio", "joinedAt", "stats", "preferences", "badges", "level", "xp"]
      },
      {
        "name": "Follow",
        "key_pattern": "social:follows:<followId>",
        "fields": ["followId", "followerId", "followingId", "followedAt", "notifications"]
      },
      {
        "name": "Activity",
        "key_pattern": "social:activities:<activityId>",
        "fields": ["activityId", "userId", "type", "metadata", "timestamp", "visibility"]
      },
      {
        "name": "Badge",
        "key_pattern": "social:badges",
        "fields": ["badgeId", "name", "description", "icon", "tier", "criteria", "rarity"]
      },
      {
        "name": "LeaderboardEntry",
        "computed": true,
        "fields": ["rank", "userId", "username", "avatar", "score", "badges", "level", "change", "changeAmount"]
      }
    ]
  },

  "xp_system": {
    "actions": {
      "view_proof": 10,
      "understand_proof": 50,
      "prove_theorem": 200,
      "make_contribution": 100,
      "bronze_badge": 100,
      "silver_badge": 250,
      "gold_badge": 500,
      "platinum_badge": 1000
    },
    "level_formula": "level = floor(sqrt(xp / 100)) + 1",
    "milestones": {
      "1": 0,
      "2": 100,
      "3": 400,
      "5": 1600,
      "10": 8100,
      "20": 36100
    }
  },

